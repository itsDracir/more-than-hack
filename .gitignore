# This repository is public. The match data is not redistributable: nothing under data/ (raw
# bundle, processed features, executed notebooks) and no generated labels may ever be committed.
data/
evaluation/results/
*.csv
*.json
*.npy
*.parquet
*.mp4
*.pdf

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.idea/
.vscode/

# The public 5-minute ground truth ships with the official repository (MIT) and is what
# evaluation/run_evaluation.py scores against. The full-match ground truth must never be here.
!evaluation/gt/*_possession_gt_public.csv
!evaluation/gt/*_possession_gt_public_meta.json
evaluation/scoreboard.csv
evaluation/reports/
